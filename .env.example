# Phase 5A protected Vercel Preview only. Configure the key as Sensitive in
# Vercel, scoped to the feature Preview. Codex Vault does not bind it in Vercel.
# VISION_BENCH_GEMINI_KEY=
# GEMPREDICT_GEMINI_FULL_ANALYSIS=false
# Set only after verifying current model rates, billed thinking and image costs
# and approving the conservative per-scan estimate. Use USD, per million tokens.
# GEMPREDICT_GEMINI_INPUT_USD_PER_MILLION=
# GEMPREDICT_GEMINI_OUTPUT_USD_PER_MILLION=
# GEMPREDICT_GEMINI_MAX_SCAN_USD=
# GEMPREDICT_GEMINI_PRICING_VERIFIED_THROUGH=  # YYYY-MM-DD UTC
# Emergency rollback for photographic Full Analysis, off by default.
# GEMPREDICT_FULL_ANALYSIS_CLAUDE_ROLLBACK=false

# My Card Library uses a separate Supabase project for Preview. Keep disabled
# until the migration, Auth users, and Preview-scoped bindings are reviewed.
# GEMPREDICT_LIBRARY_ENABLED=false
# GEMPREDICT_LIBRARY_PREVIEW_SUPABASE_URL=
# GEMPREDICT_LIBRARY_PREVIEW_PUBLISHABLE_KEY=
# GEMPREDICT_LIBRARY_PREVIEW_SERVICE_ROLE_KEY=

# Owner-only noncommercial Card API evaluation. Scope both to Phase 5D Preview.
# GEMPREDICT_CARD_API_FREE_PILOT_ENABLED=false
